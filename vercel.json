{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node tools/stage-static.js",
  "outputDirectory": "dist",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/oncogenik/api/:__route*",
      "destination": "/api/router"
    },
    {
      "source": "/oncogenik",
      "destination": "/oncogenik/index.html"
    },
    {
      "source": "/backgenapp",
      "destination": "/backgenapp/index.html"
    },
    {
      "source": "/backgenapp/:path*",
      "destination": "/backgenapp/index.html"
    }
  ]
}
